{
  "name": "backend",
  "version": "1.0.0",
  "description": "High-performance uptime monitoring backend and automated health-check probe engine",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker/probeWorker.ts",
